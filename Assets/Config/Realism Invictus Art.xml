<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
	Realism Invictus graphics (K-Mod-Magnus)

	The option that shows the unit and building art of the Realism Invictus mod instead of K-Mod's.
	A setting of this computer, stored in "Realism Invictus Art.ini"; it takes effect at once.
	The DLL does the work (CvGameCoreDLL/CvRIArt.h).
-->
<mod id="RealismInvictusArt"
	 module="RealismInvictusArt"
	 name="Realism Invictus graphics"
	 author="K-Mod-Magnus"
	 version="1.0"
	 date="10/20/2026">

	<options id="RealismInvictusArt" file="Realism Invictus Art.ini">
		<section id="RealismInvictusArt">
			<option id="Enabled" key="Enabled"
					type="boolean" default="True">
				<change function="onEnabledOptionChanged"/>
			</option>
		</section>
	</options>

	<init/>
</mod>
